{
  "name": "jdi-document-converter",
  "version": "1.0.0",
  "description": "Document Converter untuk sistem AI JDIH - Mengubah PDF gambar menjadi teks",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "cli": "node app.js",
    "test": "node --experimental-vm-modules test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html}\"",
    "benchmark": "node --experimental-vm-modules src/benchmark/runner.js"
  },
  "keywords": [
    "jdiih",
    "document-converter",
    "ocr",
    "pdf",
    "paddleocr"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.4.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "axios": "^1.7.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fs-extra": "^11.2.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "onnxruntime-node": "^1.23.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.0",
    "ppu-paddle-ocr": "^6.2.0",
    "tesseract.js": "^5.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0"
  }
}
